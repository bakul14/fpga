{
  "languages": {
    "SystemVerilog": {
      "formatter": {
        "external": {
          "command": "verible-verilog-format",
          "arguments": [
            "--flagfile",
            ".verible-format.flags",
            "-"
          ]
        }
      }
    },
    "C++": {
      "formatter": {
        "external": {
          "command": "clang-format",
          "arguments": [
            "--assume-filename={buffer_path}"
          ]
        }
      }
    }
  }
}
